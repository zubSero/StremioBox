+
+# Seed optional stores once. Existing packages, user updates and removals remain choices.
+seed_store() {
+    package=$1
+    apk=$2
+    expected=$3
+    [ -z "$(pm path "$package")" ] || return 0
+    [ "$(sha256sum "$apk" | cut -d ' ' -f 1)" = "$expected" ]
+    pm install "$apk"
+    appops set "$package" REQUEST_INSTALL_PACKAGES allow
+    [ -n "$(pm path "$package")" ]
+}
+if [ ! -e "$state/app-store-seed-completed" ]; then
+    seed_store app.flicky /system/etc/stremiobox/flicky.apk 5f8bcc05480951383fa48649d908bd5d64a8b3ef71c67871734777e702ff2204
