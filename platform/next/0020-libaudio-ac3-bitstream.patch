                          size_t bytes)
 {
@@ -1032,9 +1083,28 @@ static ssize_t out_write(struct audio_stream_out *stream, const void* buffer,
         out->buffer_type = buffer_type;
     }
 
+    int channels = popcount(out->channel_mask);
+    if (channels == 6) {
+        if (out->stereo_buffer_frames < in_frames) {
+            free(out->stereo_buffer);
+            out->stereo_buffer = malloc(in_frames * 2 * sizeof(int16_t));
+            out->stereo_buffer_frames = out->stereo_buffer ? in_frames : 0;
+        }
+        if (!out->stereo_buffer) {
+            ret = -ENOMEM;
+            goto exit;
+        }
+        if (out->ac3_active)
+            ac3_spdif_process(out->ac3, in_buffer, in_frames, out->stereo_buffer);
+        else
+            downmix_to_stereo(in_buffer, in_frames, out->stereo_buffer);
+        in_buffer = out->stereo_buffer;
+        frame_size = 2 * sizeof(int16_t);
+        channels = 2;
+    }
+
     /* Reduce number of channels, if necessary */
-    if (popcount(out_get_channels(&stream->common)) >
-                 (int)out->pcm_config.channels) {
+    if (channels > (int)out->pcm_config.channels) {
         unsigned int i;
 
         /* Discard right channel */
@@ -1441,6 +1511,8 @@ static int adev_open_output_stream(struct audio_hw_device *dev,
     out->stream.get_next_write_timestamp = out_get_next_write_timestamp;
 
     out->dev = adev;
+    out->channel_mask = config->channel_mask == AUDIO_CHANNEL_OUT_5POINT1 ?
+            AUDIO_CHANNEL_OUT_5POINT1 : AUDIO_CHANNEL_OUT_STEREO;
 
     config->format = out_get_format(&out->stream.common);
     config->channel_mask = out_get_channels(&out->stream.common);
@@ -1468,6 +1540,8 @@ static void adev_close_output_stream(struct audio_hw_device *dev __unused,
