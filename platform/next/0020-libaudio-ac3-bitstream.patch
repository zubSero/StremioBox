diff --git a/hal/ac3_spdif.c b/hal/ac3_spdif.c
new file mode 100644
index 0000000..e63017c
--- /dev/null
+++ b/hal/ac3_spdif.c
@@ -0,0 +1,224 @@
+/*
+ * 5.1 PCM -> AC-3 -> IEC61937 for the x86 primary HAL.
+ *
+ * Every 1536 input frames are encoded into one AC-3 frame, which is wrapped
+ * into one IEC61937 burst of exactly 1536 stereo S16 frames. Output is delayed
+ * by one burst so input and output frame counts stay identical; the first
+ * burst after a reset is silence.
+ */
+#define LOG_TAG "audio_hw_ac3"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <log/log.h>
+#include <sound/asound.h>
+
+#include <libavcodec/avcodec.h>
+#include <libavutil/channel_layout.h>
+
+#include "ac3_spdif.h"
+
+#define BURST_FRAMES 1536
+#define BURST_BYTES (BURST_FRAMES * 2 * 2)
+#define IN_CHANNELS 6
+#define IEC61937_AC3 0x01
+#define IEC958_AES0_NONAUDIO (1 << 1)
+
+struct ac3_spdif {
+    AVCodecContext *ctx;
+    AVFrame *frame;
+    AVPacket *packet;
+    int16_t pending[BURST_FRAMES * IN_CHANNELS]; /* input not yet encoded */
+    size_t pending_frames;
+    int16_t burst[BURST_FRAMES * 2];             /* output being drained */
+    size_t burst_pos;
+    int16_t next[BURST_FRAMES * 2];              /* most recently encoded burst */
+    int next_ready;
+};
+
+struct ac3_spdif *ac3_spdif_create(unsigned int bit_rate)
+{
+    const AVCodec *codec = avcodec_find_encoder(AV_CODEC_ID_AC3);
+    struct ac3_spdif *s = calloc(1, sizeof(*s));
+    if (!codec || !s)
+        goto fail;
+    s->ctx = avcodec_alloc_context3(codec);
+    s->frame = av_frame_alloc();
+    s->packet = av_packet_alloc();
+    if (!s->ctx || !s->frame || !s->packet)
+        goto fail;
+    s->ctx->sample_rate = 48000;
+    s->ctx->sample_fmt = AV_SAMPLE_FMT_FLTP;
+    s->ctx->bit_rate = bit_rate;
+    av_channel_layout_from_mask(&s->ctx->ch_layout, AV_CH_LAYOUT_5POINT1_BACK);
+    if (avcodec_open2(s->ctx, codec, NULL) < 0 || s->ctx->frame_size != BURST_FRAMES)
+        goto fail;
+    s->frame->nb_samples = BURST_FRAMES;
+    s->frame->format = AV_SAMPLE_FMT_FLTP;
+    s->frame->sample_rate = 48000;
+    av_channel_layout_copy(&s->frame->ch_layout, &s->ctx->ch_layout);
+    if (av_frame_get_buffer(s->frame, 0) < 0)
+        goto fail;
+    ac3_spdif_reset(s);
+    ALOGI("AC-3 encoder ready: %u kbit/s, 5.1 -> IEC61937", bit_rate / 1000);
+    return s;
+fail:
+    ALOGE("AC-3 encoder unavailable");
+    ac3_spdif_destroy(s);
+    return NULL;
+}
+
+void ac3_spdif_destroy(struct ac3_spdif *s)
+{
+    if (!s)
+        return;
+    avcodec_free_context(&s->ctx);
+    av_frame_free(&s->frame);
+    av_packet_free(&s->packet);
+    free(s);
+}
+
+void ac3_spdif_reset(struct ac3_spdif *s)
+{
+    s->pending_frames = 0;
+    memset(s->burst, 0, sizeof(s->burst));
+    s->burst_pos = 0;
+    s->next_ready = 0;
+    /* The encoder keeps only its 256-sample overlap; draining it would end the
+     * stream for good, so it simply continues with the next audio. */
+}
+
+/* Wrap one AC-3 frame as an IEC61937 burst (byte-swapped payload, zero padded). */
+static void make_burst(int16_t *burst, const uint8_t *data, int size)
+{
+    uint8_t *bytes = (uint8_t *)burst;
+    memset(burst, 0, BURST_BYTES);
+    if (size > BURST_BYTES - 8)
+        size = BURST_BYTES - 8;
+    burst[0] = (int16_t)0xF872;
+    burst[1] = 0x4E1F;
+    burst[2] = IEC61937_AC3 | ((size > 5 ? data[5] & 0x7 : 0) << 8);
+    burst[3] = size * 8;
+    for (int i = 0; i + 1 < size; i += 2) {
+        bytes[8 + i] = data[i + 1];
+        bytes[8 + i + 1] = data[i];
+    }
+    if (size & 1)
+        bytes[8 + size] = data[size - 1];
+}
+
+static void encode_pending(struct ac3_spdif *s)
+{
+    for (int c = 0; c < IN_CHANNELS; c++) {
+        float *plane = (float *)s->frame->extended_data[c];
+        for (int i = 0; i < BURST_FRAMES; i++)
+            plane[i] = s->pending[i * IN_CHANNELS + c] * (1.0f / 32768.0f);
+    }
+    if (av_frame_make_writable(s->frame) < 0 || avcodec_send_frame(s->ctx, s->frame) < 0) {
+        ALOGW("AC-3 encode failed; sending silence");
+        return;
+    }
+    while (avcodec_receive_packet(s->ctx, s->packet) == 0) {
+        make_burst(s->next, s->packet->data, s->packet->size);
+        s->next_ready = 1;
+        av_packet_unref(s->packet);
+    }
+}
+
+void ac3_spdif_process(struct ac3_spdif *s, const int16_t *in, size_t frames, int16_t *out)
+{
+    while (frames) {
+        size_t n = BURST_FRAMES - s->pending_frames;
+        if (n > BURST_FRAMES - s->burst_pos)
+            n = BURST_FRAMES - s->burst_pos;
+        if (n > frames)
+            n = frames;
+        memcpy(s->pending + s->pending_frames * IN_CHANNELS, in, n * IN_CHANNELS * sizeof(int16_t));
+        memcpy(out, s->burst + s->burst_pos * 2, n * 2 * sizeof(int16_t));
+        s->pending_frames += n;
+        s->burst_pos += n;
+        in += n * IN_CHANNELS;
+        out += n * 2;
+        frames -= n;
+        if (s->pending_frames == BURST_FRAMES) {
+            encode_pending(s);
+            s->pending_frames = 0;
+        }
+        if (s->burst_pos == BURST_FRAMES) {
+            if (s->next_ready)
+                memcpy(s->burst, s->next, sizeof(s->burst));
+            else
+                memset(s->burst, 0, sizeof(s->burst));
+            s->next_ready = 0;
+            s->burst_pos = 0;
+        }
+    }
+}
+
+int hdmi_sink_accepts_ac3(unsigned int card)
+{
+    char path[64];
+    snprintf(path, sizeof(path), "/proc/asound/card%u", card);
+    DIR *dir = opendir(path);
+    if (!dir)
+        return -1;
+    int result = -1;
+    struct dirent *entry;
+    while (result != 1 && (entry = readdir(dir))) {
+        if (strncmp(entry->d_name, "eld#", 4))
+            continue;
+        char eld[96], line[128];
+        snprintf(eld, sizeof(eld), "%s/%s", path, entry->d_name);
+        FILE *file = fopen(eld, "re");
+        if (!file)
+            continue;
+        int present = 0, ac3 = 0;
+        while (fgets(line, sizeof(line), file)) {
+            if (!strncmp(line, "monitor_present", 15) && strchr(line, '1'))
+                present = 1;
+            if (strstr(line, "_coding_type") && strstr(line, "[0x2]"))
+                ac3 = 1;
+        }
+        fclose(file);
+        if (present)
+            result = ac3;
+    }
+    closedir(dir);
+    return result;
+}
+
+int iec958_set_nonaudio(unsigned int card, int nonaudio)
+{
+    char path[32];
+    snprintf(path, sizeof(path), "/dev/snd/controlC%u", card);
+    int fd = open(path, O_RDWR | O_CLOEXEC);
+    if (fd < 0)
+        return -errno;
+    int changed = 0;
+    for (unsigned int index = 0; index < 16; index++) {
+        struct snd_ctl_elem_value value;
+        memset(&value, 0, sizeof(value));
+        value.id.iface = SNDRV_CTL_ELEM_IFACE_MIXER;
+        strcpy((char *)value.id.name, "IEC958 Playback Default");
+        value.id.index = index;
+        if (ioctl(fd, SNDRV_CTL_IOCTL_ELEM_READ, &value) < 0)
+            break;
+        unsigned char *aes0 = &value.value.iec958.status[0];
+        unsigned char wanted = nonaudio ? (*aes0 | IEC958_AES0_NONAUDIO)
+                                        : (*aes0 & ~IEC958_AES0_NONAUDIO);
+        if (wanted == *aes0)
+            continue;
+        *aes0 = wanted;
+        if (ioctl(fd, SNDRV_CTL_IOCTL_ELEM_WRITE, &value) == 0)
+            changed++;
+    }
+    close(fd);
+    return changed;
+}
diff --git a/hal/ac3_spdif.h b/hal/ac3_spdif.h
new file mode 100644
index 0000000..5bfb17e
--- /dev/null
+++ b/hal/ac3_spdif.h
@@ -0,0 +1,35 @@
+/*
+ * 5.1 PCM -> AC-3 -> IEC61937 (S/PDIF burst) conversion for HDMI outputs
+ * whose sink only accepts stereo LPCM but decodes Dolby Digital bitstreams.
+ */
+#ifndef AC3_SPDIF_H
+#define AC3_SPDIF_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Frames of added delay: one burst of buffering plus the encoder delay. */
+#define AC3_SPDIF_LATENCY_FRAMES (1536 + 256)
+
+struct ac3_spdif;
+
+struct ac3_spdif *ac3_spdif_create(unsigned int bit_rate);
+void ac3_spdif_destroy(struct ac3_spdif *s);
+/* Drop buffered audio, e.g. on standby. */
+void ac3_spdif_reset(struct ac3_spdif *s);
+/*
+ * Consume `frames` interleaved S16 5.1 frames (FL FR FC LFE BL BR) and write
+ * exactly `frames` interleaved S16 stereo IEC61937 frames to `out`.
+ */
+void ac3_spdif_process(struct ac3_spdif *s, const int16_t *in, size_t frames, int16_t *out);
+
+/* Set or clear the IEC958 non-audio bit on all HDMI/S/PDIF outputs of `card`. */
+int iec958_set_nonaudio(unsigned int card, int nonaudio);
+
+/*
+ * Whether the connected HDMI sink lists AC-3 in its ELD: 1 yes, 0 no (the sink
+ * only takes PCM), -1 no sink currently reports an ELD.
+ */
+int hdmi_sink_accepts_ac3(unsigned int card);
+
+#endif
