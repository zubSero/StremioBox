     return -ENOSYS;
 }
 
+static int16_t clamp16(int32_t sample)
+{
+    return sample > 32767 ? 32767 : sample < -32768 ? -32768 : sample;
+}
+
+/* FL FR FC LFE BL BR -> L R, keeping dialogue (centre) clearly audible. */
+static void downmix_to_stereo(const int16_t *in, size_t frames, int16_t *out)
+{
+    for (size_t i = 0; i < frames; i++, in += 6, out += 2) {
+        int32_t centre = in[2] * 707 / 1000, lfe = in[3] / 2;
+        out[0] = clamp16((in[0] + centre + lfe + in[4] / 2) * 6 / 10);
+        out[1] = clamp16((in[1] + centre + lfe + in[5] / 2) * 6 / 10);
+    }
+}
+
