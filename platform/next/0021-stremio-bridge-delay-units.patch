+// mpv hands 5.1 to Android unchanged; the HAL encodes it as AC-3 for HDMI.
+// Lines "key=value" in this optional file add mpv audio options for tuning,
+// e.g. "audio-channels=stereo" plus "audio-swresample-o=center_mix_level=1.0".
+#define AUDIO_OVERRIDE "/data/data/com.stremio.one/files/nuc-hdr/audio.conf"
+static void audio_options(JNIEnv *env,jobject obj,jlong instance) {
+    FILE *file=fopen(AUDIO_OVERRIDE,"r");
+    if(!file) return;
+    char line[256];
+    while(fgets(line,sizeof(line),file)) {
+        line[strcspn(line,"\r\n")]=0;
+        char *split=strchr(line,'=');
+        if(line[0]=='#' || !split) continue;
+        *split=0;
+        option(env,obj,instance,line,split+1);
+        LOG("AUDIO_DOWNMIX override %s=%s",line,split+1);
+    }
+    fclose(file);
+}
+
+EXPORT jint NAME(nativeSetOptionString)(JNIEnv *env,jobject self,jlong instance,jstring name,jstring value) {
+    typedef jint (*function)(JNIEnv *,jobject,jlong,jstring,jstring);
+    function fn=symbol("Java_dev_jdtech_mpv_MPVLib_nativeSetOptionString");
+    jint status=fn?fn(env,self,instance,name,value):0;
+    const char *key=(*env)->GetStringUTFChars(env,name,NULL);
+    int output=key && !strcmp(key,"ao");
+    if(key) (*env)->ReleaseStringUTFChars(env,name,key);
+    if(output) audio_options(env,self,instance);
+    return status;
+}
