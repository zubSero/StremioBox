+// Stremio's MpvPlayer passes its audio/subtitle delay setting in milliseconds
+// (a long), but mpv's audio-delay and sub-delay are seconds: a -100 ms tweak
+// became -100 s, freezing the picture while audio kept playing.
+EXPORT void NAME(nativeSetPropertyDouble)(JNIEnv *env,jobject self,jlong instance,jstring name,jdouble value) {
+    const char *key=(*env)->GetStringUTFChars(env,name,NULL);
+    if(key && (!strcmp(key,"audio-delay") || !strcmp(key,"sub-delay"))) {
+        LOG("DELAY %s %.0f ms",key,value);
+        value/=1000;
+    }
+    if(key) (*env)->ReleaseStringUTFChars(env,name,key);
+    typedef void (*function)(JNIEnv *,jobject,jlong,jstring,jdouble);
+    function fn=symbol("Java_dev_jdtech_mpv_MPVLib_nativeSetPropertyDouble");
+    if(fn) fn(env,self,instance,name,value);
+}
