+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+
+namespace android {
+
+struct Hdr10EdidCapabilities {
+  bool supported = false;
+  float max_luminance = -1.0F;
+  float max_average_luminance = -1.0F;
+  float min_luminance = -1.0F;
+};
+
+// CTA extension tag 6 describes EOTF and static metadata support. Validate
+// both block bounds and checksums before advertising a physical sink's HDR.
+inline auto ParseHdr10Edid(const uint8_t *data, size_t size)
+    -> Hdr10EdidCapabilities {
+  Hdr10EdidCapabilities result;
+  constexpr uint8_t header[] = {0, 255, 255, 255, 255, 255, 255, 0};
+  if (!data || size < 128 || !std::equal(header, header + 8, data))
+    return result;
+  const auto checksum_ok = [](const uint8_t *block) {
+    uint32_t sum = 0;
+    for (size_t i = 0; i < 128; ++i) sum += block[i];
+    return (sum & 255U) == 0;
+  };
+  if (!checksum_ok(data)) return result;
+  const size_t blocks = std::min(size / 128 - 1, size_t(data[126]));
+  for (size_t i = 1; i <= blocks; ++i) {
+    const uint8_t *ext = data + i * 128;
+    if (ext[0] != 2 || !checksum_ok(ext)) continue;
+    // A zero DTD offset declares no data-block collection.
+    const size_t end = ext[2];
+    if (end < 4 || end > 127) continue;
+    for (size_t offset = 4; offset < end;) {
+      const size_t length = ext[offset] & 31U;
+      const uint8_t tag = ext[offset] >> 5U;
+      if (offset + 1 + length > end) break;
+      const uint8_t *db = ext + offset;
+      if (tag == 7 && length >= 3 && db[1] == 6 &&
+          (db[2] & 4U) && (db[3] & 1U)) {
+        result.supported = true;  // ST2084 and static metadata type 1.
+        if (length >= 4 && db[4])
+          result.max_luminance = 50.0F * std::exp2(float(db[4]) / 32.0F);
+        if (length >= 5 && db[5])
+          result.max_average_luminance = 50.0F * std::exp2(float(db[5]) / 32.0F);
+        if (length >= 6 && db[6] && result.max_luminance > 0.0F) {
+          const float fraction = float(db[6]) / 255.0F;
+          result.min_luminance = result.max_luminance * fraction * fraction / 100.0F;
+        }
+        return result;
+      }
+      offset += 1 + length;
+    }
+  }
+  return result;
+}
+
+}  // namespace android
