+// primaryBuilderEnvAssignments keeps Ninja's command hash stable across runs.
+func primaryBuilderEnvAssignments(env map[string]string) string {
+	keys := make([]string, 0, len(env))
+	for key := range env {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	assignments := ""
+	for _, key := range keys {
+		// Keep the trusted caller's existing assignment and quoting semantics.
+		assignments += key + "=" + env[key] + " "
+	}
+	return assignments
+}
