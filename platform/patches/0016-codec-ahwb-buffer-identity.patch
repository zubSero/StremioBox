-void C2FFMPEGVideoDecodeComponent::SurfaceDescriptor::set(const std::shared_ptr<C2GraphicBlock>& block) {
+bool C2FFMPEGVideoDecodeComponent::SurfaceDescriptor::set(const std::shared_ptr<C2GraphicBlock>& block) {
+    // A16's AIDL allocator supplies AHWB handles without BufferQueue slots.
+    // Initialize the optional BQ fields and key VA imports by the backing
+    // DMA-BUF inode, which stays the same across duplicated file descriptors.
+    generation = 0;
+    igbpId = 0;
+    igbpSlot = 0;
     android::_UnwrapNativeCodec2GrallocMetadata(block->handle(),
             &width, &height, &format, &usage, &stride, &generation, &igbpId, &igbpSlot);
+    struct stat info = {};
+    if (block->handle()->numFds < 1 || fstat(block->handle()->data[0], &info) != 0) {
+        ALOGE("SurfaceDescriptor: DMA-BUF identity unavailable");
+        return false;
+    }
+    bufferId = static_cast<uint64_t>(info.st_ino);
+    return bufferId != 0;
 }
 
