# SPDX-License-Identifier: Apache-2.0
# This is a userdebug product; reuse its existing root maintenance domain.
on post-fs-data
    mkdir /data/local/nuc-stremio-update 0700 root root

# PackageManager may replace extracted native libraries after an OS update.
# Wait until its boot scan has finished before mounting our player adapter.
on property:sys.boot_completed=1
    start nuc-stremio-guard

service nuc-stremio-guard /system/bin/nuc-stremio-guard
    class late_start
    user root
    group root system log inet
    seclabel u:r:su:s0
    disabled
    oneshot
